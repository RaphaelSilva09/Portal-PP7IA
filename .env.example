# ==============================================
# Template de configuração do ambiente
# Copie este arquivo para .env.local e preencha os valores reais
# cp .env.example .env.local
# ==============================================

# ==============================================
# SUPABASE (obrigatório)
# https://supabase.com/dashboard/project/_/settings/api
# ==============================================

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima (segura para uso no browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave publicável (SDK client-side)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-aqui

# Chave de serviço (apenas server-side, NUNCA expor no client)
# Necessária para o painel admin funcionar (/api/admin/*)
# Encontre em: Project Settings → API → Service role secret
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ==============================================
# EMAIL (Resend) — convites de usuário
# https://resend.com/api-keys
# ==============================================

# API key do Resend para envio de convites (apenas server-side, NUNCA expor no client)
INVITE_EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remetente dos convites — deve ser um domínio verificado no Resend
# Exemplo: convites@seudominio.com.br
EMAIL_FROM=convites@seudominio.com.br

# URL pública da aplicação — base do link enviado nos convites
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================
# REACT QUERY DEVTOOLS
# ==============================================

# Branch atual — DevTools aparecem APENAS quando valor for "develop"
# Em produção, remova ou deixe diferente de "develop"
NEXT_PUBLIC_GIT_BRANCH=develop

# ==============================================
# ANALYTICS (Vercel)
# ==============================================

# Habilita analytics da Vercel em produção
# Use "true" apenas em produção (NODE_ENV=production)
NEXT_PUBLIC_VERCEL_ANALYTICS=false
