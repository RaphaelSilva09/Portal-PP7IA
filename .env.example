# ==============================================
# Template de configuração do ambiente
# Copie este arquivo para .env.local e preencha os valores reais
# cp .env.example .env.local
# ==============================================

# ==============================================
# better-auth (autenticação — substitui Supabase Auth)
# https://www.better-auth.com/docs/installation
# ==============================================

# Segredo usado para assinar cookies de sessão e tokens.
# Gere com: openssl rand -base64 32
# NUNCA commitar valor real, NUNCA reusar entre dev e prod.
BETTER_AUTH_SECRET=

# URL pública canônica da aplicação (sem barra no fim).
# Dev: http://localhost:3000  |  Prod: https://seudominio.com.br
BETTER_AUTH_URL=

# ==============================================
# DATABASE (Postgres — Railway / pgvector)
# ==============================================

# Connection string do Postgres. Em prod no Railway, prefira o private
# domain (sem TCP proxy). Use uselibpqcompat=true para evitar TLS strict
# em certificados auto-assinados do Railway proxy.
# Ex: postgresql://user:pass@host:port/dbname?uselibpqcompat=true&sslmode=require
DATABASE_URL=

# ==============================================
# SUPABASE (legacy — em remoção)
# Mantido para fluxos ainda não migrados. Será removido após cutover.
# https://supabase.com/dashboard/project/_/settings/api
# ==============================================

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (padrão para SDK client-side)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave anônima (compatibilidade temporária com código legado)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (apenas server-side, NUNCA expor no client)
# Encontre em: Project Settings → API → Service role secret
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================
# EMAIL (Resend) — convites + OTPs de auth + notificações
# https://resend.com/api-keys
# ==============================================

# API key do Resend (server-side, NUNCA expor no client).
# Usada por better-auth para enviar OTP de reset / verificação,
# e por fluxos de convite legados.
RESEND_API_KEY=

# Alias retrocompatível para fluxos antigos de convite.
# Pode receber o mesmo valor de RESEND_API_KEY enquanto a migração não acaba.
INVITE_EMAIL_API_KEY=

# Remetente — domínio precisa estar verificado no Resend (SPF/DKIM/DMARC)
# Exemplo: noreply@seudominio.com.br
EMAIL_FROM=

# URL pública da aplicação — base de links em e-mails
# Dev: http://localhost:3000  |  Prod: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# ==============================================
# REACT QUERY DEVTOOLS
# ==============================================

# Branch atual — DevTools aparecem APENAS quando valor for "develop"
# Em produção, remova ou deixe diferente de "develop"
NEXT_PUBLIC_GIT_BRANCH=develop

# ==============================================
# ANALYTICS (Vercel)
# ==============================================

# Habilita analytics da Vercel em produção
# Use "true" apenas em produção (NODE_ENV=production)
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# ==============================================
# RAG CHAT (Assistente)
# ==============================================

# Master switch — set to "false" to hide the chat bubble entirely
NEXT_PUBLIC_CHAT_ENABLED=true

# Provider: 'gemini' (default) | 'groq'
LLM_PROVIDER=gemini

# Gemini API key — used for embeddings and generation
# Get at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key — only needed when LLM_PROVIDER=groq
# Get at: https://console.groq.com/keys
GROQ_API_KEY=

# Model overrides (optional, defaults applied in code)
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Retrieval tuning
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.55

# Per-user daily message limit
RAG_DAILY_LIMIT=30

# Persistent chat history feature flag (off in v1)
NEXT_PUBLIC_CHAT_HISTORY=false
