{
    "buildCommand": "pnpm run build",
    "devCommand": "pnpm run dev",
    "installCommand": "pnpm install",
    "framework": "nextjs",
    "outputDirectory": ".next",
    "functions": {
        "app/api/export-pdf/**/*.ts": {
            "memory": 2048,
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron/weekly-digest",
            "schedule": "0 21 * * 3"
        }
    ]
}
